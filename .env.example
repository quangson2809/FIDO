# Copy to FIDO/.env before using Docker Compose. Do not commit the real .env.
# All Docker-specific values live here, separate from backend/.env.
MYSQL_DATABASE=fido
MYSQL_ROOT_PASSWORD=
MYSQL_TZ=UTC
DOCKER_DB_URL=jdbc:mysql://db:3306/fido?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DOCKER_DB_USERNAME=root
DOCKER_BACKEND_INTERNAL_PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_MODE=real
VITE_API_BASE_URL=http://localhost:8080/api/v1
