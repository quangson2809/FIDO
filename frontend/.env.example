# Default development mode. Use real unless an explicitly supported mock is needed.
VITE_API_MODE=real

# Local development:
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Production can use an absolute API URL, for example:
# VITE_API_BASE_URL=https://api.example.com/api/v1
# Or a same-origin reverse-proxy path, for example:
# VITE_API_BASE_URL=/api/v1

# Leave empty when the API returns absolute image URLs (for example ImgBB/CDN URLs).
# Set only when image_url is a relative path served from a separate static host.
VITE_IMAGE_BASE_URL=

# Public store contact; set confirmed contact details before publishing.
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_HOTLINE=
