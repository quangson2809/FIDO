FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

EXPOSE 5173

# Re-run npm ci against the mounted package-lock so dependency changes are picked
# up without deleting the persistent node_modules volume manually.
CMD ["sh", "-c", "npm ci --no-audit --no-fund && exec npm run dev -- --host 0.0.0.0"]
