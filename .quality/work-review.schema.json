{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fido.local/schemas/work-review-v1.json",
  "title": "FIDO Work structural review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "head_sha",
    "result",
    "summary",
    "blocking_findings",
    "findings"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "principles",
          "evidence",
          "impact",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3}$"
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR",
              "INFO"
            ]
          },
          "principles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
