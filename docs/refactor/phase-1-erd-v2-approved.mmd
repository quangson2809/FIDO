    }
    RETURNS {
        bigint id PK
        bigint order_id FK
        varchar return_number UK
        varchar status
        varchar reason
        datetime requested_at
        datetime resolved_at
    }
    RETURN_ITEMS {
        bigint id PK
        bigint return_id FK
        bigint order_item_id FK
        int quantity
        varchar item_condition
        varchar disposition
    }
    AUDIT_LOGS {
        bigint id PK
        bigint actor_account_id FK
        varchar action
        varchar entity_type
        varchar entity_id
        json before_data
        json after_data
        varchar correlation_id
        datetime created_at
    }
    CONTENT_PAGES {
        bigint id PK
        varchar slug UK
        varchar title
        text content
        varchar status
        datetime updated_at
    }

