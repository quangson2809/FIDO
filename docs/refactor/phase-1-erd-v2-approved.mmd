        bigint id PK
        bigint parent_product_id FK
        bigint category_id FK
        bigint brand_id FK
        varchar name
        varchar slug UK
        varchar sku UK
        text description
        decimal selling_price
        decimal cost_price
        varchar status
        datetime deleted_at
        datetime created_at
        datetime updated_at
    }
    ATTRIBUTE_TYPES {
        bigint id PK
        varchar code UK
        varchar name
        varchar description
        boolean is_active
    }
