erDiagram
    ACCOUNTS {
        bigint id PK
        varchar phone UK
        varchar email
        varchar password_hash
        varchar status
        datetime created_at
        datetime updated_at
    }
    ADDRESSES {
        bigint id PK
        bigint account_id FK
        varchar recipient_name
        varchar recipient_phone
        varchar province
        varchar district
        varchar ward
        varchar address_line
    }
    ROLES {
        bigint id PK
        varchar code UK
        varchar name
    }
    PERMISSIONS {
        bigint id PK
        varchar code UK
        varchar description
    }
