%% FIDO ERD v2 — contract-freeze revision, 2026-10-23
%% Base: owner-confirmed 31-table ERD supplied 2026-10-22.
%% Revision authorized by the owner's instruction to resolve P1 blockers with the smallest coherent contract change.
%% Retains 31 tables; adds explicit fields only where required to express already-recorded business decisions.
%% Physical nullability, generated columns, indexes, defaults, constraints and status literals are specified separately.
erDiagram
    ACCOUNTS {
        bigint id PK
        varchar full_name
        varchar email
        varchar phone
        varchar password_hash
        varchar status
        timestamp deleted_at "NULL means active; soft-deleted accounts release phone"
        timestamp created_at
        timestamp updated_at
    }

    ADDRESSES {
        bigint id PK
        bigint account_id FK
        varchar recipient_name
        varchar recipient_phone
        varchar province
        varchar district
        varchar ward
        varchar address_line
        boolean is_default
        timestamp created_at
        timestamp updated_at
    }

    ROLES {
        bigint id PK
        varchar code UK
        varchar name
        varchar description
        varchar status
    }

    PERMISSIONS {
        bigint id PK
        varchar code UK
        varchar name
        varchar description
    }

    ACCOUNT_ROLES {
        bigint account_id PK,FK
        bigint role_id PK,FK
    }

    ROLE_PERMISSIONS {
        bigint role_id PK,FK
        bigint permission_id PK,FK
    }

    CATEGORIES {
        bigint id PK
        bigint parent_category_id FK
        varchar name
        varchar slug UK
        varchar status
        timestamp created_at
        timestamp updated_at
    }

    BRANDS {
        bigint id PK
        varchar name
        varchar slug UK
        varchar status
    }

    PRODUCTS {
        bigint id PK
        bigint parent_product_id FK
        bigint category_id FK
        bigint brand_id FK
        varchar name "NULL for child if inherited"
        varchar slug "NULL for child if inherited"
        varchar sku UK
        text description "NULL for child if inherited"
        bigint selling_price "Integer VND; NULL on child means inherit"
        bigint cost_price "Integer VND; nullable"
        varchar status
        timestamp deleted_at
        timestamp created_at
        timestamp updated_at
    }

    ATTRIBUTE_TYPES {
        bigint id PK
        varchar code UK
        varchar name
        varchar data_type
    }

    ATTRIBUTES {
        bigint id PK
        bigint attribute_type_id FK
        varchar code UK
        varchar name
        boolean is_required
        boolean is_variant_defining
        int sort_order
    }

    ATTRIBUTE_OPTIONS {
        bigint id PK
        bigint attribute_id FK
        varchar value
        varchar label
        int sort_order
    }

    PRODUCT_ATTRIBUTE_VALUES {
        bigint product_id PK,FK
        bigint attribute_id PK,FK
        bigint option_id FK
        varchar text_value
        decimal number_value "Descriptive numeric attribute; not money"
        boolean boolean_value
    }

    PRODUCT_IMAGES {
        bigint id PK
        bigint product_id FK
        varchar image_url
        boolean is_primary
        int sort_order
        timestamp created_at
    }

    CARTS {
        bigint id PK
        bigint account_id FK
        varchar status
        timestamp created_at
        timestamp updated_at
    }

    CART_ITEMS {
        bigint id PK
        bigint cart_id FK
        bigint product_id FK
        int quantity
        timestamp added_at
        timestamp updated_at
    }

    VOUCHERS {
        bigint id PK
        varchar code UK
        varchar discount_type
        bigint discount_value "Integer VND for FIXED; integer percent basis points for PERCENT"
        bigint minimum_order_value "Integer VND"
        bigint maximum_discount "Integer VND; nullable"
        timestamp starts_at
        timestamp ends_at
        int usage_limit
        int usage_count "Atomically incremented on successful placement; never exceeds usage_limit"
        varchar status
    }

    ORDERS {
        bigint id PK
        bigint account_id FK
        bigint voucher_id FK
        varchar order_number UK
        varchar idempotency_key UK
        char(64) request_fingerprint "Canonical hash of semantic checkout input"
        varchar status
        bigint subtotal "Integer VND"
        bigint discount_amount "Integer VND"
        bigint shipping_fee "Integer VND"
        bigint total_amount "Integer VND"
        char(3) currency
        timestamp placed_at
        timestamp created_at
        timestamp updated_at
    }

    ORDER_ITEMS {
        bigint id PK
        bigint order_id FK
        bigint product_id FK
        varchar sku_snapshot
        varchar product_name_snapshot
        varchar attribute_snapshot
        varchar image_url_snapshot "Immutable retained asset reference"
        int quantity
        bigint unit_price "Integer VND"
        bigint discount_amount "Integer VND"
        bigint line_total "Integer VND"
    }

    ORDER_ADDRESSES {
        bigint order_id PK,FK
        varchar recipient_name
        varchar recipient_phone
        varchar province
        varchar district
        varchar ward
        varchar address_line
    }

    ORDER_VOUCHER_SNAPSHOTS {
        bigint order_id PK,FK
        varchar voucher_code_snapshot
        varchar discount_type_snapshot
        bigint discount_value_snapshot "Integer VND or integer percent basis points"
        bigint discount_amount_snapshot "Integer VND"
    }

    PAYMENTS {
        bigint order_id PK,FK
        varchar method
        varchar payment_status
        bigint amount "Integer VND"
        char(3) currency "VND only"
        bigint collected_by_account_id FK
        timestamp collected_at
        bigint refund_amount "Integer VND; default zero"
        bigint refunded_by_account_id FK
        timestamp refunded_at
        varchar refund_reason
        timestamp created_at
        timestamp updated_at
    }

    SHIPPING_INFOS {
        bigint order_id PK,FK
        varchar recipient_name
        varchar recipient_phone
        varchar carrier_name
        varchar tracking_number
        varchar shipping_status
        timestamp shipped_at
        timestamp delivered_at
        timestamp updated_at
    }

    SUPPLIERS {
        bigint id PK
        varchar code UK
        varchar name
        varchar phone
        varchar email
        varchar status
        timestamp created_at
        timestamp updated_at
    }

    GOODS_RECEIPTS {
        bigint id PK
        bigint supplier_id FK
        bigint warehouse_id FK "Destination warehouse for this receipt"
        varchar receipt_number UK
        varchar status
        bigint created_by FK
        bigint confirmed_by FK
        timestamp confirmed_at
        timestamp created_at
        timestamp updated_at
    }

    GOODS_RECEIPT_ITEMS {
        bigint id PK
        bigint goods_receipt_id FK
        bigint product_id FK
        int quantity_received
        bigint unit_cost "Integer VND"
    }

    WAREHOUSES {
        bigint id PK
        varchar code UK
        varchar name
        varchar status
    }

    INVENTORIES {
        bigint warehouse_id PK,FK
        bigint product_id PK,FK
        int quantity_on_hand
        int version
        timestamp updated_at
    }

    INVENTORY_TRANSACTIONS {
        bigint id PK
        bigint warehouse_id FK
        bigint product_id FK
        varchar transaction_type
        int quantity_delta
        bigint goods_receipt_item_id FK
        bigint order_item_id FK
        varchar idempotency_key UK
        varchar reason_code "Required for manual adjustments and reversals"
        bigint reverses_transaction_id FK "Nullable; reversal references original movement"
        bigint created_by FK
        timestamp created_at
    }

    AUDIT_LOGS {
        bigint id PK
        bigint actor_account_id FK
        varchar action
        varchar entity_type
        varchar entity_id
        json before_data
        json after_data
        varchar correlation_id
        timestamp created_at
    }

    CONTENT_PAGES {
        bigint id PK
        varchar slug UK
        varchar title
        text content
        varchar status
        bigint updated_by FK
        timestamp updated_at
    }

    ACCOUNTS ||--o{ ADDRESSES : owns
    ACCOUNTS ||--o{ ACCOUNT_ROLES : assigned
    ROLES ||--o{ ACCOUNT_ROLES : grants
    ROLES ||--o{ ROLE_PERMISSIONS : contains
    PERMISSIONS ||--o{ ROLE_PERMISSIONS : assigned

    CATEGORIES o|--o{ CATEGORIES : parent_of
    CATEGORIES o|--o{ PRODUCTS : classifies
    BRANDS o|--o{ PRODUCTS : brands

    PRODUCTS o|--o{ PRODUCTS : parent_of
    ATTRIBUTE_TYPES ||--o{ ATTRIBUTES : defines_type
    ATTRIBUTES ||--o{ ATTRIBUTE_OPTIONS : offers
    PRODUCTS ||--o{ PRODUCT_ATTRIBUTE_VALUES : has
    ATTRIBUTES ||--o{ PRODUCT_ATTRIBUTE_VALUES : describes
    ATTRIBUTE_OPTIONS o|--o{ PRODUCT_ATTRIBUTE_VALUES : selected_option
    PRODUCTS ||--o{ PRODUCT_IMAGES : has

    ACCOUNTS ||--o{ CARTS : owns
    CARTS ||--|{ CART_ITEMS : contains
    PRODUCTS ||--o{ CART_ITEMS : selected

    ACCOUNTS ||--o{ ORDERS : places
    VOUCHERS o|--o{ ORDERS : applied
    ORDERS ||--|{ ORDER_ITEMS : contains
    PRODUCTS ||--o{ ORDER_ITEMS : snapshot_source
    ORDERS ||--|| ORDER_ADDRESSES : delivery_snapshot
    ORDERS ||--o| ORDER_VOUCHER_SNAPSHOTS : voucher_snapshot
    ORDERS ||--|| PAYMENTS : cod_payment
    ORDERS ||--o| SHIPPING_INFOS : manual_shipping

    SUPPLIERS o|--o{ GOODS_RECEIPTS : supplies
    ACCOUNTS ||--o{ GOODS_RECEIPTS : creates
    GOODS_RECEIPTS ||--|{ GOODS_RECEIPT_ITEMS : contains
    PRODUCTS ||--o{ GOODS_RECEIPT_ITEMS : received_sku

    WAREHOUSES ||--o{ INVENTORIES : stores
    PRODUCTS ||--o{ INVENTORIES : stock_balance
    WAREHOUSES ||--o{ INVENTORY_TRANSACTIONS : ledger
    PRODUCTS ||--o{ INVENTORY_TRANSACTIONS : movement
    GOODS_RECEIPT_ITEMS o|--o{ INVENTORY_TRANSACTIONS : receipt_source
    ORDER_ITEMS o|--o{ INVENTORY_TRANSACTIONS : order_source
    ACCOUNTS o|--o{ INVENTORY_TRANSACTIONS : records

    ACCOUNTS o|--o{ AUDIT_LOGS : performs
    ACCOUNTS o|--o{ CONTENT_PAGES : updates
