        bigint account_id PK, FK
        bigint role_id PK, FK
    }
    ROLE_PERMISSIONS {
        bigint role_id PK, FK
        bigint permission_id PK, FK
    }
    CATEGORIES {
        bigint id PK
        bigint parent_id FK
        varchar name
        varchar slug UK
        boolean is_active
    }
    BRANDS {
        bigint id PK
        varchar name
        varchar slug UK
        boolean is_active
    }
