# Copy to backend/.env and supply your own values. This file is a template only.
# spring.config.import uses Java-properties syntax (KEY=value).
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/fido?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
JPA_SHOW_SQL=false
DEV_SEED_ENABLED=false

# Optional bootstrap; enabled only with intentional credentials.
SUPERADMIN_BOOTSTRAP_ENABLED=false
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=

# REQUIRED: Generate a private, random signing key of at least 32 bytes, encoded in Base64.
# Never commit or share the actual secret. No public dev signing-key fallback exists.
JWT_SECRET_BASE64=
JWT_ISSUER=fido
JWT_TTL_SECONDS=900

# Checkout fee is server-owned; baseline is defined by approved business rules.
CHECKOUT_SHIPPING_FEE=30000.00

# Upload constraints; ImgBB key is only required when actually uploading images.
IMAGE_STORAGE_MAX_UPLOAD_SIZE=32MB
IMAGE_STORAGE_MAX_REQUEST_SIZE=64MB
IMAGE_STORAGE_MAX_FILES_PER_REQUEST=10
IMGBB_API_KEY=
IMGBB_BASE_URL=https://api.imgbb.com
IMGBB_CONNECT_TIMEOUT=5s
IMGBB_READ_TIMEOUT=20s
