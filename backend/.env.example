# Chép thành backend/.env rồi điền cấu hình riêng; file này chỉ là mẫu.
# spring.config.import đọc theo cú pháp Java properties: KEY=value.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/fido?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
JPA_SHOW_SQL=false
DEV_SEED_ENABLED=false

# Chỉ bật khởi tạo SUPERADMIN khi chủ động cấp thông tin đăng nhập bên dưới.
SUPERADMIN_BOOTSTRAP_ENABLED=false
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=

# Bắt buộc tạo khóa ký riêng ngẫu nhiên ít nhất 32 byte rồi mã hóa Base64.
# Không commit/chia sẻ khóa thật; không có khóa dev công khai để tự dùng khi thiếu cấu hình.
JWT_SECRET_BASE64=
JWT_ISSUER=fido
JWT_TTL_SECONDS=900

# Phí giao hàng do máy chủ quyết định; giá trị mặc định theo quy tắc nghiệp vụ đã duyệt.
CHECKOUT_SHIPPING_FEE=30000.00

# Giới hạn upload; chỉ cần khóa ImgBB khi thực sự tải ảnh lên nhà cung cấp.
IMAGE_STORAGE_MAX_UPLOAD_SIZE=32MB
IMAGE_STORAGE_MAX_REQUEST_SIZE=64MB
IMAGE_STORAGE_MAX_FILES_PER_REQUEST=10
IMGBB_API_KEY=
IMGBB_BASE_URL=https://api.imgbb.com
IMGBB_CONNECT_TIMEOUT=5s
IMGBB_READ_TIMEOUT=20s
