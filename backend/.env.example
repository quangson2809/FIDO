DB_URL=jdbc:mysql://localhost:3306/fido?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=123456
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
JPA_SHOW_SQL=false
DEV_SEED_ENABLED=false

# Optional local admin bootstrap. Keep disabled unless the credentials below are set intentionally.
SUPERADMIN_BOOTSTRAP_ENABLED=false
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=

# Explicitly select dev when running locally (see README); there is no implicit dev profile.
# Optional for local dev because application-dev.properties has a public dev-only fallback.
# Required for shared/staging/production environments. Generate a random >=32-byte key and Base64-encode it.
# JWT_SECRET_BASE64=
JWT_ISSUER=fido
JWT_TTL_SECONDS=900

# Backend only. Used for admin multipart product image upload.
# Keep IMGBB_API_KEY only in local/runtime secret configuration; never expose it to frontend variables.
IMGBB_API_KEY=
IMGBB_BASE_URL=https://api.imgbb.com
IMGBB_CONNECT_TIMEOUT=5s
IMGBB_READ_TIMEOUT=20s
IMAGE_STORAGE_MAX_UPLOAD_SIZE=32MB
IMAGE_STORAGE_MAX_FILES_PER_REQUEST=10
