FROM gradle:9.3.1-jdk17

# Image chỉ dành cho dev; root tránh lệch quyền file bind-mount giữa Docker Desktop và Linux.
# Không dùng image này cho môi trường production.
USER root
ENV GRADLE_USER_HOME=/root/.gradle
WORKDIR /workspace

# Tải sẵn dependency Gradle vào cache; Compose sẽ gắn source ứng dụng từ máy chủ.
COPY build.gradle.kts settings.gradle.kts gradle.properties ./
COPY gradle ./gradle
COPY gradlew gradlew.bat ./
RUN gradle --no-daemon dependencies

EXPOSE 8080

CMD ["gradle", "bootRun", "--no-daemon"]
